{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["xp"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChild('name')",
        "name":       { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40" },
        "lang":       { ".validate": "newData.isString() && newData.val().length <= 8" },
        "xp":         { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000" },
        "level":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
        "streak":     { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "dailyDone":  { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "online":     { ".validate": "newData.isBoolean()" },
        "lastActive": { ".validate": "newData.isNumber()" },
        "$other":     { ".validate": false }
      }
    },
    "chat": {
      ".read": "auth != null",
      "$msg": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || (data.exists() && data.child('uid').val() === auth.uid))",
        ".validate": "newData.hasChildren(['uid','name','text','ts'])",
        "uid":  { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 280" },
        "ts":   { ".validate": "newData.isNumber()" },
        "edited": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
